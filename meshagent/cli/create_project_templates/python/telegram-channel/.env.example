# Copy this file to .env or run ./scripts/configure-telegram.sh.
# Keep .env private.

# Required. Create or reuse a Telegram API app at https://my.telegram.org.
# TELEGRAM_API_HASH is only needed for local Telethon dev and BotFather setup.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required. Paste an existing bot token, or create one with BotFather.
# ./scripts/create-bot-token.sh can help, but it also needs TELEGRAM_API_ID and
# TELEGRAM_API_HASH to sign in to Telegram.
# deploy.sh stores this as a service-account secret instead of putting it into
# the service spec.
TELEGRAM_BOT_TOKEN=

# Optional deploy service-account settings. deploy.sh creates or reuses this
# service account and stores Telegram private values under it.
MESHAGENT_TELEGRAM_SERVICE_ACCOUNT_NAME=python-telegram-channel
MESHAGENT_TELEGRAM_SERVICE_ACCOUNT_EMAIL=
MESHAGENT_TELEGRAM_BOT_TOKEN_SECRET_ID=
MESHAGENT_TELEGRAM_WEBHOOK_SECRET_ID=
MESHAGENT_TELEGRAM_WEBHOOK_DOMAIN=

# Optional local-dev agent/channel settings.
MESHAGENT_AGENT_NAME=python-telegram-channel
MESHAGENT_THREAD_STORAGE=dataset
MESHAGENT_TELEGRAM_THREAD_PREFIX=.threads/telegram
MESHAGENT_TELEGRAM_MEDIA_STORAGE_PREFIX=.threads/telegram-media
MESHAGENT_TELEGRAM_INBOUND_MEDIA_MAX_BYTES=50000000
MESHAGENT_TELEGRAM_ALLOWED_CHAT_IDS=
MESHAGENT_TELEGRAM_RESPONSE_TIMEOUT=300
# MESHAGENT_TELEGRAM_BOT_API_BASE_URL=http://localhost:8081

# Optional deploy webhook URL/domain. If URL is blank, deploy.sh derives
# https://<domain>/telegram/webhook from MESHAGENT_TELEGRAM_WEBHOOK_DOMAIN or
# the room's default MeshAgent pages domain. deploy.sh registers the final URL
# with Telegram after deploying and stores the webhook validation secret
# automatically.
MESHAGENT_TELEGRAM_WEBHOOK_URL=
