# Copy this file to .env.
# Keep .env private.

# Required. Find these in the Twilio Console for the account that owns the SMS
# sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional local-dev agent/channel settings.
MESHAGENT_AGENT_NAME=python-twilio-channel
MESHAGENT_THREAD_STORAGE=dataset
MESHAGENT_TWILIO_THREAD_PREFIX=.threads/twilio
MESHAGENT_TWILIO_MEDIA_STORAGE_PREFIX=.threads/twilio-media
MESHAGENT_TWILIO_INBOUND_MEDIA_MAX_BYTES=25000000
MESHAGENT_TWILIO_ALLOWED_FROM_NUMBERS=
MESHAGENT_TWILIO_RESPONSE_TIMEOUT=300
# MESHAGENT_TWILIO_API_BASE_URL=http://localhost:8081/2010-04-01

# Set to 1 for local queue tests when you do not want to send real Twilio
# Messages API requests.
MESHAGENT_TWILIO_DRY_RUN=0
