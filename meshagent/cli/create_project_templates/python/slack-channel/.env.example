# Copy this file to .env or run ./scripts/configure-slack.sh.
# Keep .env private.

# Required for sending responses through Slack Web API.
SLACK_BOT_TOKEN=

# Required for deployed Slack Events API request validation.
SLACK_SIGNING_SECRET=

# Optional local-dev agent/channel settings.
MESHAGENT_AGENT_NAME=python-slack-channel
MESHAGENT_THREAD_STORAGE=dataset
MESHAGENT_IMAGE_GENERATION_MODEL=gpt-image-2
MESHAGENT_SLACK_EVENTS_BASE_DOMAIN=meshagent.dev
MESHAGENT_SLACK_EVENTS_DOMAIN=
MESHAGENT_SLACK_EVENTS_URL=
MESHAGENT_SLACK_EVENTS_SERVICE_NAME=python-slack-channel-events
MESHAGENT_SLACK_EVENTS_PORT=8000
MESHAGENT_SLACK_SIGNING_SECRET_ID=
MESHAGENT_SLACK_THREAD_PREFIX=.threads/slack
MESHAGENT_SLACK_ALLOWED_CHANNELS=
MESHAGENT_SLACK_RESPONSE_TIMEOUT=300
MESHAGENT_SLACK_REPLY_IN_THREAD=1
MESHAGENT_SLACK_IGNORE_BOTS=1
MESHAGENT_SLACK_OUTBOUND_FILE_MAX_BYTES=50000000

# Set to 1 for local queue tests when you do not want to send real Slack
# chat.postMessage requests.
MESHAGENT_SLACK_DRY_RUN=0
