# Copy this file to .env.
# Keep .env private.

# Required. Find these in the Meta app dashboard and WhatsApp Business Platform
# phone number settings.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Optional local-dev agent/channel settings.
MESHAGENT_AGENT_NAME=python-whatsapp-channel
MESHAGENT_THREAD_STORAGE=dataset
MESHAGENT_WHATSAPP_THREAD_PREFIX=.threads/whatsapp
MESHAGENT_WHATSAPP_MEDIA_STORAGE_PREFIX=.threads/whatsapp-media
MESHAGENT_WHATSAPP_INBOUND_MEDIA_MAX_BYTES=25000000
MESHAGENT_WHATSAPP_ALLOWED_FROM_NUMBERS=
MESHAGENT_WHATSAPP_RESPONSE_TIMEOUT=300
MESHAGENT_WHATSAPP_SEND_READ_RECEIPTS=1
MESHAGENT_WHATSAPP_SEND_TYPING_INDICATOR=1

# Set to 1 for local queue tests when you do not want to send real WhatsApp
# Cloud API requests.
MESHAGENT_WHATSAPP_DRY_RUN=0
