{
  "name": "meshagent-create-typescript-room-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "codex": "meshagent room connect -- meshagent codex join --agent-name codex --channel chat --thread-storage codex",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 meshagent room connect -- node dev-server.mjs",
    "deploy": "meshagent deploy . --tag meshagent-create-typescript-workspace-app:dev --private --validation-mode=cookie --liveness /health --wait",
    "start": "NEXT_TELEMETRY_DISABLED=1 node .next/standalone/server.js"
  },
  "dependencies": {
    "@meshagent/meshagent": "^__MESHAGENT_CLIENT_VERSION__",
    "@meshagent/meshagent-livekit": "^__MESHAGENT_CLIENT_VERSION__",
    "@meshagent/meshagent-node": "^__MESHAGENT_CLIENT_VERSION__",
    "@meshagent/meshagent-react": "^__MESHAGENT_CLIENT_VERSION__",
    "@meshagent/meshagent-react-dev": "^__MESHAGENT_CLIENT_VERSION__",
    "@meshagent/meshagent-tailwind": "^__MESHAGENT_CLIENT_VERSION__",
    "lucide-react": "^0.545.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "typescript": "^5.8.0"
  }
}
