// @ts-nocheck
const fs = require("node:fs");
const path = require("node:path");
const { JsonContent, RoomClient, Tool, Toolkit, startHostedToolkit } = require("@meshagent/meshagent");

const proofDisplayPath = "src/chatbot-proof.json";
const proofPath = path.join(__dirname, proofDisplayPath.split("/").pop());
const toolkitName = "meshagent.create.typescript-chatbot";
const sessions = new Map();

function sleep(milliseconds) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

function normalizeMessage(message) {
  const text = String(message ?? "").trim();
  if (text === "") {
    return "Say something.";
  }
  return text;
}

function transcriptForSession(sessionId) {
  const key = String(sessionId ?? "").trim() || "default";
  if (!sessions.has(key)) {
    sessions.set(key, []);
  }
  return sessions.get(key);
}

function chatbotReply({ sessionId, message }) {
  const text = normalizeMessage(message);
  const transcript = transcriptForSession(sessionId);
  const previousUserMessage = [...transcript].reverse().find((item) => item.role === "user");
  const reply = /^what did i just say\??$/i.test(text) && previousUserMessage
    ? `Your previous message was: ${previousUserMessage.content}`
    : `You said: ${text}`;

  transcript.push({ role: "user", content: text });
  transcript.push({ role: "assistant", content: reply });

  return {
    sessionId: String(sessionId ?? "").trim() || "default",
    reply,
    messages: transcript.map((item) => ({ ...item })),
  };
}

async function writeChatbotProof({ probe, sessionId, messages }) {
  const payload = {
    probe,
    sessionId,
    messages,
    tools: ["chat"],
  };
  await fs.promises.mkdir(path.dirname(proofPath), { recursive: true });
  await fs.promises.writeFile(proofPath, `${JSON.stringify(payload, null, 2)}\n`, "utf8");
  return payload;
}

class TypeScriptChatTool extends Tool {
  constructor() {
    super({
      name: "chat",
      title: "Chat with local bot",
      description: "Replies to a message with a minimal TypeScript chatbot response.",
      inputSchema: {
        type: "object",
        required: ["sessionId", "message"],
        additionalProperties: false,
        properties: {
          sessionId: { type: "string" },
          message: { type: "string" },
        },
      },
    });
  }

  async execute({ sessionId, message }) {
    return new JsonContent({ json: chatbotReply({ sessionId, message }) });
  }
}

class TypeScriptChatbotToolkit extends Toolkit {
  constructor() {
    super({
      name: toolkitName,
      title: "TypeScript Local Chatbot Toolkit",
      description: "Local-only chat tool for the TypeScript chatbot.",
      tools: [new TypeScriptChatTool()],
    });
  }
}

async function runDevChatbotToolkit(existingRoom) {
  const probe = process.env.MESHAGENT_CREATE_DEV_PROBE;
  if (!process.env.MESHAGENT_ROOM || !process.env.MESHAGENT_TOKEN) {
    return;
  }

  const room = existingRoom ?? new RoomClient();
  if (!existingRoom) {
    await room.start();
  }
  const hostedToolkit = await startHostedToolkit({
    room,
    toolkit: new TypeScriptChatbotToolkit(),
    public_: true,
  });

  try {
    if (!probe) {
      await new Promise(() => {});
      return;
    }

    const sessionId = `meshagent-create-chat-${probe}`;
    const firstMessage = `MeshAgent local dev proof ${probe}`;
    const firstTurn = await room.agents.invokeTool({
      toolkit: toolkitName,
      tool: "chat",
      arguments: { sessionId, message: firstMessage },
    });
    console.log(`MeshAgent create dev chatbot turn 1: ${JSON.stringify(firstTurn.json)}`);
    if (firstTurn.json?.reply !== `You said: ${firstMessage}`) {
      throw new Error("Local TypeScript chatbot proof did not reply to the first turn.");
    }

    const secondMessage = "What did I just say?";
    const secondTurn = await room.agents.invokeTool({
      toolkit: toolkitName,
      tool: "chat",
      arguments: { sessionId, message: secondMessage },
    });
    console.log(`MeshAgent create dev chatbot turn 2: ${JSON.stringify(secondTurn.json)}`);
    const expectedSecondReply = `Your previous message was: ${firstMessage}`;
    if (secondTurn.json?.reply !== expectedSecondReply) {
      throw new Error("Local TypeScript chatbot proof did not preserve the chat session.");
    }

    const messages = secondTurn.json?.messages ?? [];
    const expectedMessages = [
      { role: "user", content: firstMessage },
      { role: "assistant", content: `You said: ${firstMessage}` },
      { role: "user", content: secondMessage },
      { role: "assistant", content: expectedSecondReply },
    ];
    if (JSON.stringify(messages) !== JSON.stringify(expectedMessages)) {
      throw new Error("Local TypeScript chatbot proof did not produce the expected transcript.");
    }

    await writeChatbotProof({ probe, sessionId, messages });
    console.log(`MeshAgent create dev chatbot proof wrote: ${proofDisplayPath} ${probe}`);
    const holdSeconds = Number.parseFloat(process.env.MESHAGENT_CREATE_DEV_TOOLKIT_HOLD_SECONDS ?? "0");
    if (Number.isFinite(holdSeconds) && holdSeconds > 0) {
      console.log(`MeshAgent create dev chatbot holding registration for ${holdSeconds}s`);
      await sleep(holdSeconds * 1000);
    }
  } finally {
    await hostedToolkit.stop();
    if (!existingRoom) {
      room.dispose();
    }
  }
}

async function main() {
  if (!process.env.MESHAGENT_ROOM || !process.env.MESHAGENT_TOKEN) {
    console.log("MeshAgent room environment is not set; waiting for deployment env.");
    await new Promise(() => {});
    return;
  }

  const room = new RoomClient();
  await room.start();
  console.log(`Connected to MeshAgent room: ${room.roomName}`);
  try {
    await runDevChatbotToolkit(room);
  } finally {
    room.dispose();
  }
}

main().catch((error) => {
  console.error("Unable to start MeshAgent RoomClient chatbot:", error);
  process.exitCode = 1;
});
