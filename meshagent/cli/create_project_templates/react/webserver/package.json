{
  "name": "meshagent-create-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "meshagent room connect -- sh -c 'node scripts/dev-content-toolkit.js & vite --host 0.0.0.0'",
