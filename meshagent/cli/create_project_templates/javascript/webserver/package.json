    "start": "node dist/index.js"
  },
  "dependencies": {
    "@meshagent/meshagent": "^__MESHAGENT_CLIENT_VERSION__"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3"
  }
}
